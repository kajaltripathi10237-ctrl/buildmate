{
  "info": {
    "_postman_id": "buildmate-api-collection-2026-separate",
    "name": "BuildMate API",
    "description": "Separate endpoint requests for the live BuildMate backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://buildmate-backend-vsfa.onrender.com", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "response": []
    },
    {
      "name": "POST /api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('token', json.token);",
              "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
              "if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);",
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@buildmate.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      },
      "response": []
    },
    {
      "name": "POST /api/auth/signup",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Contractor\",\n  \"email\": \"contractor@example.com\",\n  \"phone\": \"+1-555-0101\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"CONTRACTOR\"\n}"
        },
        "url": "{{base_url}}/api/auth/signup"
      },
      "response": []
    },
    {
      "name": "POST /api/auth/refresh",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/refresh"
      },
      "response": []
    },
