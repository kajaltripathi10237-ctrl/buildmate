generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CONTRACTOR
  WORKER
  VENDOR
  ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  SHORTLISTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  REVIEW
  RESOLVED
  CLOSED
}

model Role {
  id            String          @id @default(uuid())
  name          RoleName        @unique
  userRoles     UserRole[]
  rolePermissions RolePermission[]
  createdAt     DateTime        @default(now())
}

model Permission {
  id              String          @id @default(uuid())
  name            String          @unique
  rolePermissions RolePermission[]
  createdAt       DateTime        @default(now())
}

model RolePermission {
  id          String     @id @default(uuid())
  roleId      String
  permissionId String
  role        Role       @relation(fields: [roleId], references: [id])
  permission  Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id             String            @id @default(uuid())
  name           String
  email          String            @unique
  phone          String?
  password       String?
  avatarUrl      String?
  isVerified     Boolean           @default(false)
  isActive       Boolean           @default(true)
  refreshToken   String?
  role           RoleName          @default(WORKER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  contractor     Contractor?
  worker         Worker?
  vendor         Vendor?
  admin          Admin?
  jobsPosted     Job[]             @relation("JobPostedBy")
  applications   JobApplication[]
  attendanceLogs WorkerAttendance[]
  wallet         Wallet?
  payments       Payment[]
  transactions   Transaction[]
  notifications  Notification[]
  sentMessages   Message[]         @relation("SentMessages")
  chatRooms      ChatParticipant[]
  documents      Document[]
  tickets        SupportTicket[]
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]
  reviews        Review[]
  ratings        Rating[]
  userRoles      UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Contractor {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String?
  companyLicense String?
  address        String?
  employeeCount  Int?
  user           User     @relation(fields: [userId], references: [id])
  jobs           Job[]
  projects       Project[]
  createdAt      DateTime @default(now())
}

model Worker {
  id              String   @id @default(uuid())
  userId          String   @unique
  trade           String?
  skillSet        String[]
  experienceYears Int?
  certifications  String[]
  kycStatus       String   @default("PENDING")
  availability    String   @default("AVAILABLE")
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
}

model Vendor {
  id          String             @id @default(uuid())
  userId      String             @unique
  companyName String?
  category    String?
  address     String?
  user        User               @relation(fields: [userId], references: [id])
  listings    MaterialListing[]
  equipment   EquipmentListing[]
  createdAt   DateTime           @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  department String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Job {
  id             String          @id @default(uuid())
  title          String
  description    String
  tradeType      String          @default("GENERAL")
  skillsRequired String[]
  wage           Float?
  budget         Float
  location       String
  duration       String?
  priority       String          @default("MEDIUM")
  status         JobStatus       @default(OPEN)
  postedById     String
  contractorId   String?
  postedBy       User            @relation("JobPostedBy", fields: [postedById], references: [id])
  contractor     Contractor?     @relation(fields: [contractorId], references: [id])
  applications   JobApplication[]
  project        Project?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@index([status, location])
}

model JobApplication {
  id        String            @id @default(uuid())
  jobId     String
  workerId  String
  status    ApplicationStatus @default(PENDING)
  note      String?
  job       Job               @relation(fields: [jobId], references: [id])
  worker    User              @relation(fields: [workerId], references: [id])
  createdAt DateTime          @default(now())

  @@unique([jobId, workerId])
}

model Project {
  id           String        @id @default(uuid())
  name         String
  description  String?
  status       String        @default("ACTIVE")
  contractorId String?
  jobId        String?       @unique
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  contractor   Contractor?   @relation(fields: [contractorId], references: [id])
  job          Job?          @relation(fields: [jobId], references: [id])
  tasks        ProjectTask[]
  reports      ProjectReport[]
  createdAt    DateTime      @default(now())
}

model ProjectReport {
  id        String   @id @default(uuid())
  projectId String
  summary   String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      String   @default("TODO")
  dueDate     DateTime?
  project     Project  @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
}

model WorkerAttendance {
  id          String           @id @default(uuid())
  userId      String
  status      AttendanceStatus @default(PRESENT)
  checkInTime DateTime?
  checkOutTime DateTime?
  location    String?
  qrCode      String?
  user        User             @relation(fields: [userId], references: [id])
  logs        AttendanceLog[]
  createdAt   DateTime         @default(now())
}

model AttendanceLog {
  id             String           @id @default(uuid())
  attendanceId   String
  type           String           @default("CHECK_IN")
  deviceInfo     String?
  gpsCoordinates String?
  notes          String?
  attendance     WorkerAttendance @relation(fields: [attendanceId], references: [id])
  createdAt      DateTime         @default(now())
}

model MarketplaceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model MaterialListing {
  id          String   @id @default(uuid())
  vendorId    String
  title       String
  category    String
  price       Float
  stock       Int      @default(0)
  description String?
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  createdAt   DateTime @default(now())
}

model EquipmentListing {
  id          String   @id @default(uuid())
  vendorId    String
  title       String
  category    String
  price       Float
  availability String @default("AVAILABLE")
  description String?
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  createdAt   DateTime @default(now())
}

model RentOrder {
  id         String   @id @default(uuid())
  userId     String
  equipmentId String?
  startDate  DateTime
  endDate    DateTime
  total      Float
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model PurchaseOrder {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  quantity  Int      @default(1)
  total     Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  amount    Float
  currency  String        @default("USD")
  provider  String        @default("STRIPE")
  status    PaymentStatus @default(PENDING)
  reference String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
}

model EscrowAccount {
  id        String   @id @default(uuid())
  userId    String
  balance   Float    @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  invoiceNo String   @unique
  amount    Float
  status    String   @default("DRAFT")
  pdfUrl    String?
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Float
  description String?
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("USD")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ChatRoom {
  id          String            @id @default(uuid())
  name        String?
  isGroup     Boolean           @default(false)
  participants ChatParticipant[]
  messages    Message[]
  createdAt   DateTime          @default(now())
}

model ChatParticipant {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  room     ChatRoom @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  senderId    String
  content     String?
  fileUrl     String?
  messageType String   @default("TEXT")
  room        ChatRoom @relation(fields: [roomId], references: [id])
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  name      String
  category  String
  fileUrl   String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  score     Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model VendorReport {
  id        String   @id @default(uuid())
  vendorId  String
  summary   String
  createdAt DateTime @default(now())
}

model WorkerReport {
  id        String   @id @default(uuid())
  workerId  String
  summary   String
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  details   String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  status      String   @default("OPEN")
  description String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Dispute {
  id        String        @id @default(uuid())
  userId    String
  reason    String
  status    DisputeStatus @default(OPEN)
  message   String?
  createdAt DateTime      @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AppVersion {
  id        String   @id @default(uuid())
  version   String
  notes     String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Analytics {
  id        String   @id @default(uuid())
  metric    String
  value     Float
  label     String?
  createdAt DateTime @default(now())
}

